# ==============================================================================
# IA INMOBILIARIA - VARIABLES DE ENTORNO
# ==============================================================================
# En modo demostración (sin variables configuradas), la aplicación utiliza el
# motor de reglas colombiano y el catálogo de muestra seguro de Inmobiliaria Premier.
#
# Para conectar la plataforma a clientes reales en producción, configura:
# ==============================================================================

# 1. SUPABASE (PostgreSQL Multi-Inmobiliaria & RLS)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_publica
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_privada

# 2. OPENAI (GPT-4o Mini en Servidor)
OPENAI_API_KEY=sk-proj-tu-clave-secreta-de-openai

# 3. WHATSAPP CLOUD API (Opcional - Meta Developers)
WHATSAPP_API_TOKEN=tu_token_de_meta
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=tu_token_de_verificacion

# 4. SEGURIDAD DE ADMINISTRADOR (Opcional)
ADMIN_API_SECRET=clave_secreta_para_administracion
